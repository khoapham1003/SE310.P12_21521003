@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="main">
    <div class="box box-2">
        <div class="box-details">
            <h4>@ViewBag.TotalCustomers</h4>
            <span>customers</span>
        </div>
        <div class="box-icon">
            <i class="fas fa-users"></i>
        </div>
    </div>
    <div class="box box-4">
        <div class="box-details">
            <h4>@ViewBag.TotalAdmins</h4>
            <span>admin</span>
        </div>
        <div class="box-icon">
            <i class="fas fa-shopping-bag"></i>
        </div>
    </div>
    <div class="box box-3">
        <div class="box-details">
            <h4>@ViewBag.TotalProducts</h4>
            <span>products</span>
        </div>
        <div class="box-icon">
            <i class="fas fa-tasks"></i>
        </div>
    </div>
    
    <div class="box box-5">
        <div class="box-details">
            <h4>@ViewBag.TotalProducts</h4>
            <span>products</span>
        </div>
        <div class="box-icon">
            <i class="fas fa-wallet"></i>
        </div>
    </div>
</section>
<a asp-controller="Product" asp-action="Index" class="btn btn-link">Product List</a>
<a asp-controller="User" asp-action="Index" class="btn btn-link">User List</a>
<a asp-controller="User" asp-action="Login" class="btn btn-link">Logout</a>
</div>
<style>
    .main {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin: 20px;
    }

    .box {
        background-color: #f4f4f4;
        padding: 20px;
        border-radius: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .box:hover {
            transform: translateY(-10px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

    .box-details h4 {
        font-size: 28px;
        margin: 0;
        color: #333; /* Màu chữ chính */
    }

    .box-details span {
        font-size: 14px;
        color: #666; /* Màu chữ phụ */
    }

    .box-icon {
        font-size: 36px;
        color: #666; /* Màu biểu tượng */
    }

    .box-2 {
        background-color: #FFD700;
        color: #000; /* Màu chữ box-2 */
    }

    .box-3 {
        background-color: #FF4500;
        color: #fff; /* Màu chữ box-3 */
    }

    .box-4 {
        background-color: #32CD32;
        color: #fff; /* Màu chữ box-4 */
    }

    .box-5 {
        background-color: #1E90FF;
        color: #fff; /* Màu chữ box-5 */
    }
</style>
