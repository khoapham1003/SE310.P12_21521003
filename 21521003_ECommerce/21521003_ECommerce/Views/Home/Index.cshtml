@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_MainLayOut.cshtml";
}

@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<Product>



@foreach (var item in Model)
{
    <div class="col-lg-4 col-md-6 col-sm-12 pb-1">
        <div class="card product-item border-0 mb-4">
            <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
                <img class="img-fluid w-100" src="@($"img/{item.Picture}")" alt="">
            </div>
            <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
                <h6 class="text-truncate mb-3">@item.ProductName</h6>
                <div class="d-flex justify-content-center">
                    <h6>@item.Price VNĐ</h6>
                    <h6 class="text-muted ml-2"><del><i>@((int)(item.Price * (decimal)1.2)).000</i></del></h6>
                </div>
                <div class="card-footer d-flex justify-content-between bg-light border">
                    <a class="btn btn-sm text-dark p-0" asp-controller="Home" asp-action="Detail" asp-route-detailId="@item.ProductId"><i class="fas fa-eye text-primary mr-1"></i>View Detail</a>
                </div>
            </div>
        </div>
    </div>
}   
@Html.PagedListPager(Model,page=>Url.Action("Index",new{page=page}))


</div>
